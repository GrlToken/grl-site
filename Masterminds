let atual = 0;

function mostrar(idx) {
  atual = idx;
  const mod = modulos[idx];

  // Atualiza sidebar
  document.querySelectorAll(".modulo-item").forEach((el, i) => {
    el.classList.toggle("ativo", i === idx);
  });

  // Monta conteúdo
  let html = `
    <div class="mod-tag">${mod.num}</div>
    <div class="mod-titulo">${mod.titulo}</div>
    <div class="mod-subtitulo">${mod.subtitulo}</div>
  `;

  mod.secoes.forEach(s => {
    html += `<div class="mod-secao"><h2>${s.titulo}</h2>${s.corpo}</div>`;
  });

  // Navegação
  html += `<div class="nav-modulos">`;
  if (mod.anterior !== undefined) {
    html += `<button class="btn-nav" onclick="mostrar(${mod.anterior})">← Anterior</button>`;
  }
  if (mod.proximo !== undefined) {
    html += `<button class="btn-nav primario" onclick="mostrar(${mod.proximo})">Próximo →</button>`;
  }
  html += `</div>`;

  document.getElementById("conteudo").innerHTML = html;
  document.getElementById("conteudo").scrollTop = 0;
  window.scrollTo(0, 0);
}

mostrar(0);
</script>

