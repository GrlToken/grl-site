<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Masterminds</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #fff;
      font-family: Consolas, monospace;
      color: #003366;
      min-height: 100vh;
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 20px;
      border-bottom: 1px solid rgba(0,51,102,0.12);
      position: sticky;
      top: 0;
      background: #fff;
      z-index: 100;
    }

    .header-titulo { font-size: 11px; letter-spacing: 3px; text-transform: uppercase; opacity: .4; }

    .btn-voltar {
      font-family: Consolas, monospace;
      font-size: 11px;
      color: #003366;
      background: transparent;
      border: 1px solid rgba(0,51,102,0.25);
      border-radius: 8px;
      padding: 5px 12px;
      cursor: pointer;
      text-decoration: none;
    }

    .container {
      display: grid;
      grid-template-columns: 220px 1fr;
      min-height: calc(100vh - 45px);
    }

    /* SIDEBAR */
    .sidebar {
      border-right: 1px solid rgba(0,51,102,0.10);
      padding: 32px 16px;
      position: sticky;
      top: 45px;
      height: calc(100vh - 45px);
      overflow-y: auto;
    }

    .sidebar-titulo {
      font-size: 9px;
      letter-spacing: 3px;
      text-transform: uppercase;
      opacity: .3;
      margin-bottom: 20px;
    }

    .modulo-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 8px;
      cursor: pointer;
      margin-bottom: 4px;
      transition: background .15s;
      border: none;
      background: transparent;
      width: 100%;
      text-align: left;
      font-family: Consolas, monospace;
      color: #003366;
    }

    .modulo-item:hover { background: rgba(0,51,102,0.04); }
    .modulo-item.ativo { background: rgba(0,51,102,0.08); }

    .modulo-num {
      font-size: 9px;
      opacity: .3;
      min-width: 20px;
    }

    .modulo-nome {
      font-size: 11px;
      opacity: .7;
      line-height: 1.4;
    }

    .modulo-item.ativo .modulo-nome { opacity: 1; font-weight: 600; }

    /* CONTEÚDO */
    .conteudo {
      padding: 48px 40px;
      max-width: 680px;
    }

    .mod-tag {
      font-size: 9px;
      letter-spacing: 3px;
      text-transform: uppercase;
      opacity: .3;
      margin-bottom: 8px;
    }

    .mod-titulo {
      font-size: 24px;
      font-weight: 700;
      color: #003366;
      margin-bottom: 6px;
      line-height: 1.2;
    }

    .mod-subtitulo {
      font-size: 11px;
      opacity: .35;
      letter-spacing: 1px;
      margin-bottom: 40px;
      text-transform: uppercase;
    }

    .mod-secao {
      margin-bottom: 36px;
    }

    .mod-secao h2 {
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      opacity: .4;
      margin-bottom: 14px;
      padding-bottom: 8px;
      border-bottom: 1px solid rgba(0,51,102,0.08);
    }

    .mod-secao p {
      font-size: 13px;
      line-height: 1.8;
      opacity: .75;
      margin-bottom: 12px;
    }

    .mod-secao ul {
      list-style: none;
      margin-bottom: 12px;
    }

    .mod-secao ul li {
      font-size: 13px;
      line-height: 1.8;
      opacity: .75;
      padding-left: 16px;
      position: relative;
      margin-bottom: 6px;
    }

    .mod-secao ul li::before {
      content: "—";
      position: absolute;
      left: 0;
      opacity: .4;
    }

    .citacao {
      border-left: 2px solid rgba(0,51,102,0.2);
      padding: 12px 20px;
      margin: 20px 0;
      font-size: 13px;
      font-style: italic;
      opacity: .6;
      line-height: 1.7;
    }

    .desafio {
      background: rgba(0,51,102,0.03);
      border: 1px solid rgba(0,51,102,0.1);
      border-radius: 10px;
      padding: 20px;
      margin-bottom: 16px;
    }

    .desafio-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
    }

    .desafio-num {
      font-size: 9px;
      letter-spacing: 2px;
      text-transform: uppercase;
      opacity: .4;
    }

    .desafio-duracao {
      font-size: 9px;
      opacity: .35;
      margin-left: auto;
    }

    .desafio-titulo {
      font-size: 12px;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .desafio p {
      font-size: 12px;
      line-height: 1.7;
      opacity: .65;
      margin-bottom: 6px;
    }

    .desafio-reflexao {
      font-size: 11px;
      opacity: .45;
      font-style: italic;
      margin-top: 8px;
      padding-top: 8px;
      border-top: 1px solid rgba(0,51,102,0.08);
    }

    .nav-modulos {
      display: flex;
      gap: 12px;
      margin-top: 48px;
      padding-top: 32px;
      border-top: 1px solid rgba(0,51,102,0.08);
    }

    .btn-nav {
      font-family: Consolas, monospace;
      font-size: 11px;
      color: #003366;
      background: transparent;
      border: 1px solid rgba(0,51,102,0.25);
      border-radius: 8px;
      padding: 8px 16px;
      cursor: pointer;
      transition: background .15s;
    }

    .btn-nav:hover { background: rgba(0,51,102,0.04); }
    .btn-nav.primario { background: #003366; color: #fff; border-color: #003366; }
    .btn-nav.primario:hover { opacity: .88; }

    @media (max-width: 640px) {
      .container { grid-template-columns: 1fr; }
      .sidebar { position: static; height: auto; border-right: none; border-bottom: 1px solid rgba(0,51,102,0.10); padding: 20px 16px; }
      .conteudo { padding: 32px 20px; }
    }
  </style>
</head>
