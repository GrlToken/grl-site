<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Superminds — Iniciação</title>

<!--
  LEITOR DO LIVRO — integração
  ============================
  1. Este arquivo espera que o Firebase App e o Firebase Auth já estejam
     inicializados na página (como já deve estar no seu dashboard.html).
     Se for usar este arquivo sozinho, inicialize o Firebase antes do
     bloco <script> principal no final deste arquivo.

  2. O botão da dashboard deve apenas navegar para esta página, por exemplo:
       <a href="/leitor.html?livro=superminds-iniciacao">Ler Superminds</a>

  3. Regras do Firestore (ver arquivo firestore.rules.txt) devem garantir
     que só usuário autenticado (e, se aplicável, com o campo de compra
     verificado) consegue ler a coleção "books/{bookId}/pages".

  4. Proteções aplicadas aqui (nenhuma é 100% à prova de cópia, mas juntas
     dificultam bastante a extração casual do conteúdo):
       - sem botão de download / sem link para o PDF
       - seleção de texto desabilitada
       - menu de contexto (botão direito) desabilitado
       - atalhos comuns de salvar/imprimir bloqueados
       - conteúdo carregado sob demanda, página a página (não expõe
         o livro inteiro de uma vez na rede)
-->

<style>
  :root {
    --navy: #071229;
    --white-bg: #ffffff;
    --text-blue: #122446;
    --bar-accent: #3a588a;
    --soft-grey: #78849b;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    overflow: hidden;
    background: var(--navy);
    font-family: Georgia, "Crimson Pro", "Palatino Linotype", serif;
    -webkit-user-select: none;
    -moz-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }

  #reader-app {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--navy);
  }

  #book-frame {
    position: relative;
    width: 100%;
    max-width: 480px;
    height: 100%;
    max-height: 900px;
    background: var(--white-bg);
    overflow: hidden;
    box-shadow: 0 0 60px rgba(0,0,0,0.4);
  }

  .page {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 7% 8%;
    background: var(--white-bg);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .page.visible { opacity: 1; }
  .page.bg-navy { background: var(--navy); }

  .nav-btn {
    position: absolute;
    bottom: 10px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(18,36,70,0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: var(--text-blue);
    z-index: 5;
    cursor: pointer;
    user-select: none;
  }
  .nav-btn.left { left: 10px; }
  .nav-btn.right { right: 10px; }

  .page-number {
    position: absolute;
    bottom: 20px;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 12px;
    color: var(--soft-grey);
    pointer-events: none;
  }

  /* --- capa / folha de rosto / breather --- */
  .centered-block {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .title-main {
    font-weight: 700;
    font-size: 30px;
    letter-spacing: 0;
    color: var(--text-blue);
    margin: 0;
  }
  .title-sub {
    font-size: 18px;
    color: var(--text-blue);
    margin: 14px 0 0;
  }
  .title-tagline {
    font-style: italic;
    font-size: 14px;
    color: var(--text-blue);
    margin: 14px 0 0;
  }
  .breather-logo {
    width: 90px;
    height: auto;
  }

  /* --- epígrafe / impacto --- */
  .epigraph-text, .impact-text {
    font-style: italic;
    color: var(--text-blue);
    text-align: center;
    line-height: 1.5;
  }
  .epigraph-text { font-size: 20px; }
  .impact-text { font-size: 24px; }
  .ellipsis-mark {
    font-style: italic;
    color: var(--soft-grey);
    font-size: 17px;
    text-align: center;
    margin-bottom: 14px;
  }

  /* --- capítulo --- */
  .chapter-header {
    display: flex;
    align-items: flex-start;
    margin-bottom: 22px;
    flex-shrink: 0;
  }
  .chapter-bar {
    width: 4px;
    background: var(--bar-accent);
    align-self: stretch;
    margin-right: 14px;
    flex-shrink: 0;
  }
  .chapter-title {
    font-weight: 700;
    font-size: 22px;
    color: var(--text-blue);
    margin: 0 0 6px;
  }
  .chapter-subtitle {
    font-style: italic;
    font-size: 15px;
    color: var(--text-blue);
    margin: 0;
  }

  .chapter-body {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 56px;
    font-size: 17px;
    line-height: 1.5;
    color: var(--text-blue);
  }
  .chapter-body p {
    margin: 0 0 13px;
  }
  .chapter-body p.embedded-question {
    font-style: italic;
    text-align: center;
    margin: 8px 0;
  }
  .topic-list {
    margin: 4px 0 13px;
    padding: 0;
  }
  .topic-list li {
    list-style: none;
    color: var(--soft-grey);
    margin-bottom: 3px;
  }

  /* --- colofão --- */
  .colophon-label { font-size: 13px; color: var(--soft-grey); margin: 0; }
  .colophon-brand { font-weight: 700; font-size: 17px; color: var(--text-blue); margin: 8px 0; }

  .locked-msg {
    color: #fff;
    text-align: center;
    padding: 40px;
    font-size: 15px;
  }

  /* seleção de texto: transparente mesmo se user-select for contornado */
  ::selection { background: transparent; }
  ::-moz-selection { background: transparent; }

  img { -webkit-user-drag: none; }

  /* impressão: o navegador respeita isso mesmo se o JS for bloqueado/ignorado */
  @media print {
    html, body, #reader-app { display: none !important; }
  }
</style>
</head>
<body oncontextmenu="return false;">

<div id="reader-app">
  <div id="book-frame">
    <div id="page-container"></div>
    <div class="nav-btn left" onclick="Reader.prev()">‹</div>
    <div class="nav-btn right" onclick="Reader.next()">›</div>
  </div>
</div>

<script>
/* ====== bloqueios simples de cópia (ver aviso no topo do arquivo) ====== */
document.addEventListener('keydown', function (e) {
  var blocked = (e.ctrlKey || e.metaKey) && ['c','s','p','u','x'].includes(e.key.toLowerCase());
  if (blocked || e.key === 'PrintScreen') e.preventDefault();
});
document.addEventListener('dragstart', function (e) { e.preventDefault(); });
document.addEventListener('copy', function (e) { e.preventDefault(); });
document.addEventListener('cut', function (e) { e.preventDefault(); });
document.addEventListener('selectstart', function (e) { e.preventDefault(); });

// some navegadores disparam isto antes de abrir a caixa de impressão
window.addEventListener('beforeprint', function () {
  document.getElementById('page-container').innerHTML =
    '<div class="locked-msg">A impressão deste conteúdo não está disponível.</div>';
});
window.addEventListener('afterprint', function () {
  Reader.goTo(Reader.currentOrder ? Reader.currentOrder() : 1);
});
</script>

<script type="module">
import { auth, db } from "./firebase.js";
import { onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";
import { doc, getDoc, collection } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";

/* ====== leitor ====== */
const Reader = (function () {
  const LOGO_B64 = "";

  let bookId = new URLSearchParams(window.location.search).get('livro') || 'superminds-iniciacao';
  let currentOrder = 1;
  let totalPages = 1;
  let pageCache = {};

  function pad(n) { return String(n).padStart(4, '0'); }

  async function fetchPage(order) {
    if (pageCache[order]) return pageCache[order];
    const pageRef = doc(collection(doc(db, 'books', bookId), 'pages'), pad(order));
    const snap = await getDoc(pageRef);
    const data = snap.exists() ? snap.data() : null;
    pageCache[order] = data;
    return data;
  }

  function renderChapterBody(page) {
    let html = '';
    (page.paragraphs || []).forEach(p => {
      if (typeof p === 'object' && p.type === 'question') {
        html += `<p class="embedded-question">${escapeHtml(p.text)}</p>`;
      } else {
        html += `<p>${escapeHtml(p)}</p>`;
      }
    });
    if (page.list) {
      html += '<ul class="topic-list">';
      page.list.forEach(li => html += `<li>${escapeHtml(li)}</li>`);
      html += '</ul>';
    }
    (page.paragraphsAfterList || []).forEach(p => html += `<p>${escapeHtml(p)}</p>`);
    return html;
  }

  function escapeHtml(str) {
    const d = document.createElement('div');
    d.innerText = str;
    return d.innerHTML;
  }

  function renderPage(page, order) {
    const container = document.getElementById('page-container');
    const el = document.createElement('div');
    el.className = 'page';

    if (page.type === 'cover') {
      el.classList.add('bg-navy');
      el.innerHTML = `<div class="centered-block">
          <img class="breather-logo" style="width:150px;margin-bottom:24px" src="data:image/png;base64,${LOGO_B64}">
        </div>`;
    } else if (page.type === 'title') {
      el.innerHTML = `<div class="centered-block">
          <p class="title-main">${escapeHtml(page.title)}</p>
          <p class="title-sub">${escapeHtml(page.subtitle)}</p>
          <p class="title-tagline">${escapeHtml(page.tagline)}</p>
        </div>`;
    } else if (page.type === 'breather') {
      el.classList.add('bg-navy');
      el.innerHTML = `<div class="centered-block">
          <img class="breather-logo" src="data:image/png;base64,${LOGO_B64}">
        </div>`;
    } else if (page.type === 'epigraph') {
      el.innerHTML = `<div class="centered-block"><p class="epigraph-text">${
        page.lines.map(escapeHtml).join('<br>')
      }</p></div>`;
    } else if (page.type === 'impact') {
      const ell = page.ellipsisBefore ? '<p class="ellipsis-mark">…</p>' : '';
      let body;
      if (page.lines) {
        body = page.lines.map(l => l === '' ? '<br>' : escapeHtml(l)).join('<br>');
      } else {
        body = escapeHtml(page.text);
      }
      el.innerHTML = `<div class="centered-block">${ell}<p class="impact-text">${body}</p></div>`;
    } else if (page.type === 'chapter-open' || page.type === 'chapter-continue') {
      const header = page.silent ? '' : `<div class="chapter-header">
          <div class="chapter-bar"></div>
          <div>
            <p class="chapter-title">${escapeHtml(page.chapter)}</p>
            ${page.subtitle ? `<p class="chapter-subtitle">${escapeHtml(page.subtitle)}</p>` : ''}
          </div>
        </div>`;
      el.innerHTML = `${header}<div class="chapter-body">${renderChapterBody(page)}</div>
        <div class="page-number">${order}</div>`;
    } else if (page.type === 'colophon') {
      el.innerHTML = `<div class="centered-block">
          <p class="colophon-label">${escapeHtml(page.label)}</p>
          <p class="colophon-brand">${escapeHtml(page.brand)}</p>
          <p class="colophon-label">${escapeHtml(page.edition)}</p>
        </div>`;
    }

    container.innerHTML = '';
    container.appendChild(el);
    requestAnimationFrame(() => el.classList.add('visible'));
  }

  async function goTo(order) {
    if (order < 1 || order > totalPages) return;
    currentOrder = order;
    const page = await fetchPage(order);
    if (page) renderPage(page, order);
    // pré-carrega vizinhas, sem expor o livro inteiro de uma vez
    fetchPage(order + 1);
    fetchPage(order - 1);
  }

  function next() { goTo(currentOrder + 1); }
  function prev() { goTo(currentOrder - 1); }

  let touchStartX = null;
  let touchStartY = null;
  document.addEventListener('touchstart', e => {
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
  });
  document.addEventListener('touchend', e => {
    if (touchStartX === null) return;
    const dx = e.changedTouches[0].clientX - touchStartX;
    const dy = e.changedTouches[0].clientY - touchStartY;
    // só conta como virada de página se o movimento for predominantemente horizontal
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
      if (dx > 0) prev(); else next();
    }
    touchStartX = null;
    touchStartY = null;
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'ArrowRight') next();
    if (e.key === 'ArrowLeft') prev();
  });

  async function init() {
    const bookRef = doc(db, 'books', bookId);
    const bookDoc = await getDoc(bookRef);
    if (!bookDoc.exists()) {
      document.getElementById('page-container').innerHTML =
        '<div class="locked-msg">Conteúdo não encontrado.</div>';
      return;
    }
    totalPages = bookDoc.data().totalPages || 1;
    goTo(1);
  }

  onAuthStateChanged(auth, user => {
    if (!user) {
      document.getElementById('page-container').innerHTML =
        '<div class="locked-msg">Faça login e adquira o material para ler.</div>';
      return;
    }
    init();
  });

  return { next, prev, goTo, currentOrder: () => currentOrder };
})();

window.Reader = Reader;
</script>
</body>
</html>
